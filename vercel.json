{
  "version": 2,
  "builds": [
    {
      "src": "api.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/solve/(.*)",
      "dest": "/api.py"
    },
    {
      "src": "/score/(.*)",
      "dest": "/api.py"
    },
    {
      "src": "/letter-values",
      "dest": "/api.py"
    },
    {
      "src": "/docs",
      "dest": "/api.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/api.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
